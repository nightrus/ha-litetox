{
  "config": {
    "step": {
      "user": {
        "title": "Litetox proxy",
        "description": "Connect a tracker on your litetox proxy. The IMEI is registered on the proxy — logins from any other IMEI are rejected. The ALTOX SERVER 2.0 address is set in the integration options.",
        "data": {
          "url": "Proxy URL",
          "api_token": "API token",
          "imei": "Tracker IMEI",
          "name": "Name"
        },
        "data_description": {
          "url": "For example https://traccar.example.com",
          "imei": "Module ID (SMS ID1 / SETTINGS2)"
        }
      },
      "reconfigure": {
        "title": "Proxy settings",
        "description": "Tracker IMEI: {imei}",
        "data": {
          "url": "Proxy URL",
          "api_token": "API token"
        }
      },
      "reauth_confirm": {
        "title": "New API token",
        "description": "Proxy {url} rejected the token.",
        "data": {
          "api_token": "API token"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the proxy",
      "invalid_auth": "Invalid API token",
      "invalid_imei": "Invalid IMEI",
      "register_failed": "Proxy refused to register the tracker"
    },
    "abort": {
      "already_configured": "This tracker is already configured",
      "reconfigure_successful": "Settings updated",
      "reauth_successful": "Token updated"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Litetox proxy options",
        "data": {
          "scan_interval": "Polling interval",
          "heater_minutes": "Heater run time",
          "altox_host": "ALTOX SERVER 2.0 host",
          "altox_port": "ALTOX SERVER 2.0 port"
        },
        "data_description": {
          "heater_minutes": "Minutes for the heater switch (10–120). 0 — module default (TIME1).",
          "altox_host": "The proxy mirrors the module session to this server so the official ALTOX app keeps working. Default d2.altox.app; leave empty to disable the mirror.",
          "altox_port": "Default 20332"
        }
      }
    },
    "error": {
      "invalid_host": "Invalid host",
      "invalid_auth": "Invalid API token",
      "cannot_connect": "Cannot connect to the proxy"
    }
  },
